# Obtain this credential from your authorized Porichoy organization account.
# Never expose it with a NEXT_PUBLIC_ prefix.
PORICHOY_API_KEY=

# Porichoy provider configuration. Keep HTTPS in production.
PORICHOY_BASE_URL=https://api.porichoybd.com
PORICHOY_NID_PATH=/api/v2/verifications/autofill
PORICHOY_BIRTH_PATH=/api/v1/verifications/autofill

# Optional hard timeout for upstream verification requests.
PORICHOY_TIMEOUT_MS=15000

# Official BDRIS portal (used for birth verification when Porichoy key is absent,
# or when the client forces provider=bdris). No API key required.
BDRIS_BASE_URL=https://everify.bdris.gov.bd
BDRIS_TIMEOUT_MS=20000

# Optional per-instance abuse control. Vercel serverless instances are ephemeral,
# so use platform/WAF or a durable store as an additional production control.
VERIFY_RATE_LIMIT=6
VERIFY_RATE_WINDOW_MS=300000
