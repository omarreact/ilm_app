# Optional: Porichoy authorized API for birth verification (preferred when set).
# Never expose with a NEXT_PUBLIC_ prefix.
PORICHOY_API_KEY=

# Porichoy provider configuration. Keep HTTPS in production.
PORICHOY_BASE_URL=https://api.porichoybd.com
PORICHOY_BIRTH_PATH=/api/v1/verifications/autofill
PORICHOY_TIMEOUT_MS=15000

# Official BDRIS portal (used when Porichoy key is absent, or provider=bdris).
# No API key required. User solves CAPTCHA.
BDRIS_BASE_URL=https://everify.bdris.gov.bd
BDRIS_TIMEOUT_MS=20000

# Optional per-instance abuse control.
VERIFY_RATE_LIMIT=6
VERIFY_RATE_WINDOW_MS=300000
